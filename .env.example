# Obrazy publikowane przez workflow GitHub Actions do GHCR.
LITHOPHANE_BACKEND_IMAGE=ghcr.io/TWOJ_LOGIN/TWOJE_REPO-backend:latest
LITHOPHANE_FRONTEND_IMAGE=ghcr.io/TWOJ_LOGIN/TWOJE_REPO-frontend:latest

LITHOPHANE_BACKEND_CONTAINER_NAME=lithophane-backend
LITHOPHANE_BACKEND_HOSTNAME=backend
LITHOPHANE_FRONTEND_CONTAINER_NAME=lithophane-frontend
LITHOPHANE_FRONTEND_HOSTNAME=lithophane

# Adres frontendu jest ustawiony na stałe w docker-compose.yml: 10.10.50.19
DOCKER_NETWORK=VLAN50_Docker
LITHOPHANE_DNS=10.10.50.1
LITHOPHANE_DOMAIN=litofania.example.pl
TZ=Europe/Warsaw

TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

LITHOPHANE_BACKEND_MEM_LIMIT=1g
LITHOPHANE_BACKEND_MEM_RESERVATION=256m
LITHOPHANE_FRONTEND_MEM_LIMIT=256m
LITHOPHANE_FRONTEND_MEM_RESERVATION=64m
