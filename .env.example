LITHOPHANE_IMAGE=ghcr.io/klimuszko/litho:latest
LITHOPHANE_CONTAINER_NAME=lithophane
LITHOPHANE_HOSTNAME=lithophane

# Adres kontenera jest ustawiony w docker-compose.yml: 10.10.50.19
DOCKER_NETWORK=VLAN50_Docker
LITHOPHANE_DNS=10.10.50.1
LITHOPHANE_DOMAIN=litofania.example.pl
TZ=Europe/Warsaw

TRAEFIK_ENTRYPOINT=websecure
TRAEFIK_CERTRESOLVER=letsencrypt

LITHOPHANE_MEM_LIMIT=8g
LITHOPHANE_MEM_RESERVATION=512m

# Projekty klientów i dostęp administracyjny dla integracji WooCommerce
LITHOPHANE_DATA_PATH=/volume1/docker/Litho/data
# Ustaw długi losowy sekret, np. co najmniej 32 znaki. Pusty wyłącza endpointy /api/admin/*.
LITHO_ADMIN_API_KEY=change-me-to-a-long-random-secret
# Domena WordPressa; kilka domen rozdziel przecinkami.
LITHO_CORS_ORIGINS=https://sklep.example.pl
